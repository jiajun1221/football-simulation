<UserControl x:Class="FootballSimulation.Wpf.Controls.TacticalSettingsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TacticalPillButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Style>
                            <Style TargetType="AccessText">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TacticalTabButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTacticDropdownButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="7.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="▼"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="7.5"
                                           FontWeight="Bold"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TacticalRangeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#2563EB" Offset="0" />
                                        <GradientStop Color="#64748B" Offset="0.5" />
                                        <GradientStop Color="#EF4444" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"
                                                         Stroke="{DynamicResource AppTextBrush}"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer MaxHeight="{Binding PanelMaxHeight, ElementName=Root}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel>
            <TextBlock x:Name="CompactTitleTextBlock"
                       Text="Tactics"
                       Foreground="{DynamicResource AppTextBrush}"
                       FontSize="8"
                       FontWeight="Bold"
                       Margin="0,0,0,3"
                       Visibility="Collapsed" />

            <TextBlock x:Name="SummaryTextBlock"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       LineHeight="17"
                       TextWrapping="Wrap"
                       Margin="0,0,0,7" />

            <UniformGrid Columns="2" Margin="0,0,0,5">
                <Button x:Name="PresetTabButton" Content="Types"
                        Style="{StaticResource TacticalTabButtonStyle}"
                        FontSize="12" Padding="8,5" MinHeight="34" Margin="0,0,2,0"
                        Click="PresetTabButton_Click" />
                <Button x:Name="FormationTabButton" Content="Formations"
                        Style="{StaticResource TacticalTabButtonStyle}"
                        FontSize="12" Padding="8,5" MinHeight="34" Margin="2,0,0,0"
                        Click="FormationTabButton_Click" />
            </UniformGrid>

            <WrapPanel x:Name="PresetPanel"
                       Margin="0,0,0,6" />

            <StackPanel x:Name="CardsPanel" />

            <WrapPanel x:Name="FormationPanel"
                       Margin="0,0,0,6" />

            <Border x:Name="FormationPreviewBorder"
                    Height="230"
                    Margin="0,4,0,6"
                    Background="#173F2C"
                    BorderBrush="#86B99A"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="FormationPreviewTitleTextBlock"
                               Margin="10,7,10,0"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Panel.ZIndex="2" />
                    <Canvas x:Name="FormationPreviewCanvas" Margin="8,28,8,8" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
