<UserControl x:Class="FootballSimulation.Wpf.Views.HalfTimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FootballSimulation.Wpf.Controls"
             Background="{DynamicResource AppPageBackground}">
    <UserControl.Resources>
        <Style x:Key="PitchPlayerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TraitIconBadgeTemplate">
            <Border Width="14"
                    Height="14"
                    Background="{Binding Background}"
                    CornerRadius="7"
                    Margin="1,0,0,0"
                    ToolTip="{Binding TooltipText}">
                <TextBlock Text="{Binding Icon}"
                           Foreground="{Binding Foreground}"
                           FontFamily="{Binding FontFamily}"
                           FontSize="8"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TraitTooltipRowTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="18"
                        Height="18"
                        Background="{Binding Background}"
                        CornerRadius="9"
                        Margin="0,1,7,0">
                    <TextBlock Text="{Binding Icon}"
                               Foreground="{Binding Foreground}"
                               FontFamily="{Binding FontFamily}"
                               FontSize="10"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}"
                               Foreground="{DynamicResource AppTextBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CardStatusBadgeTemplate">
            <Border MinWidth="14"
                    Height="14"
                    Background="{Binding Background}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="2,0,0,0"
                    ToolTip="{Binding TooltipText}">
                <TextBlock Text="{Binding Text}"
                           Foreground="{Binding Foreground}"
                           FontSize="7.5"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PitchPlayerCardTemplate">
            <Border Width="108"
                    Height="74"
                    Background="{Binding CardBackground}"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="{Binding CardBorderThickness}"
                    CornerRadius="10"
                    Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl Content="{Binding SubstitutionStatusBadge}"
                                    ContentTemplate="{StaticResource CardStatusBadgeTemplate}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="-10,-10,0,0"
                                    Panel.ZIndex="10">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubstitutionStatusBadge}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding PositionBackground}" CornerRadius="7" Padding="5,1" Margin="0,0,3,0">
                                <TextBlock Text="{Binding PositionText}" Foreground="White" FontSize="7.5" FontWeight="Black" />
                            </Border>
                            <TextBlock Text="{Binding ShirtNumberText}" Foreground="White" FontSize="8" FontWeight="Black" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{Binding FormBadgeBackground}" CornerRadius="7" Padding="6,1" ToolTip="First-half rating">
                            <TextBlock Text="{Binding FormBadgeText}" Foreground="{Binding FormBadgeForeground}" FontSize="8" FontWeight="Black" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:FlagBadge FlagSource="{Binding FlagImagePath}"
                                            ToolTip="{Binding NationalityName}"
                                            Width="20"
                                            Height="14"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlayerName}"
                                   Foreground="{Binding TextForeground}"
                                   FontSize="9.2"
                                   FontWeight="Black"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding OverallBadgeBackground}" MinWidth="20" Height="14"
                                CornerRadius="7" Padding="4,0" Margin="0,0,3,0">
                            <TextBlock Text="{Binding OverallValueText}" Foreground="{Binding OverallBadgeForeground}"
                                       FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding GrowthText}" Foreground="{Binding GrowthForeground}"
                                   FontSize="7" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Border Grid.Column="3" Background="#EAF1FF" CornerRadius="7" Padding="5,1"
                                HorizontalAlignment="Right" ToolTip="{Binding TraitSummaryText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TraitIconText}" Foreground="#1E528F" FontSize="7.5" FontWeight="Black" Margin="0,0,2,0" />
                                <TextBlock Text="{Binding TraitCountText}" Foreground="#1E528F" FontSize="7" FontWeight="Black" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                Margin="0,3,0,0">
                        <Border Background="{Binding WorkloadRiskBrush}"
                                CornerRadius="7"
                                Padding="3,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                ToolTip="{Binding WorkloadRiskTooltip}">
                            <TextBlock Text="{Binding WorkloadRiskText}"
                                       FontFamily="Segoe UI Emoji"
                                       Foreground="{Binding WorkloadRiskForeground}"
                                       FontSize="7"
                                       FontWeight="Black" />
                        </Border>
                        <Border Background="{Binding FatigueWarningBadgeBackground}"
                                CornerRadius="7"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                ToolTip="{Binding FatigueWarningTooltip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FatigueWarningText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FatigueWarningText}"
                                       Foreground="#FFFFFF"
                                       FontSize="7"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Background="{Binding FormBadgeBackground}"
                                CornerRadius="7"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0">
                            <TextBlock Text="{Binding FormBadgeText}"
                                       Foreground="{Binding FormBadgeForeground}"
                                       FontSize="7"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Background="#EAF1FF"
                                CornerRadius="7"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                ToolTipService.ShowDuration="20000">
                            <Border.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{Binding TraitSummaryText}"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,7" />
                                        <ItemsControl ItemsSource="{Binding TraitBadges}"
                                                      ItemTemplate="{StaticResource TraitTooltipRowTemplate}" />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TraitCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding TraitIconText}"
                                           Foreground="#1E528F"
                                           FontSize="7.5"
                                           FontWeight="Black"
                                           Margin="0,0,2,0" />
                                <TextBlock Text="{Binding TraitCountText}"
                                           Foreground="#1E528F"
                                           FontSize="7"
                                           FontWeight="Black" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding CardStatusBadges}"
                                      ItemTemplate="{StaticResource CardStatusBadgeTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardStatusBadges.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,2,0,0" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="5" />
                        </Grid.RowDefinitions>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Stamina}"
                                     Foreground="{Binding StaminaBrush}" Background="#334155"
                                     BorderThickness="0" ToolTip="Stamina" />
                        <ProgressBar Grid.Row="1" Margin="0,2,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding WorkloadRiskBarValue}" Foreground="{Binding WorkloadRiskBrush}"
                                     Background="#334155" BorderThickness="0" ToolTip="{Binding WorkloadRiskTooltip}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SubstituteCardTemplate">
            <Border Width="128"
                    MinHeight="70"
                    Background="{Binding CardBackground}"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="3"
                    CornerRadius="10"
                    Padding="6"
                    Margin="0,0,0,7"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="SubstituteCard_PreviewMouseLeftButtonDown"
                    MouseMove="SubstituteCard_MouseMove"
                    PreviewDragEnter="SubstituteCard_DragEnter"
                    PreviewDragOver="SubstituteCard_DragOver"
                    PreviewDragLeave="SubstituteCard_DragLeave"
                    PreviewDrop="SubstituteCard_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl Content="{Binding SubstitutionStatusBadge}"
                                    ContentTemplate="{StaticResource CardStatusBadgeTemplate}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="-11,-11,0,0"
                                    Panel.ZIndex="10">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubstitutionStatusBadge}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding PositionBackground}" CornerRadius="7" Padding="5,1" Margin="0,0,3,0">
                                <TextBlock Text="{Binding Position}" Foreground="White" FontSize="7.5" FontWeight="Black" />
                            </Border>
                            <TextBlock Text="{Binding ShirtNumberText}" Foreground="White" FontSize="8" FontWeight="Black" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{Binding BenchFormBadgeBackground}" CornerRadius="7" Padding="6,1" ToolTip="First-half rating">
                            <TextBlock Text="{Binding BenchFormBadgeText}" Foreground="{Binding BenchFormBadgeForeground}" FontSize="8" FontWeight="Black" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:FlagBadge FlagSource="{Binding FlagImagePath}"
                                            ToolTip="{Binding NationalityName}"
                                            Width="20"
                                            Height="14"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Foreground="{Binding TextForeground}"
                                   FontSize="9.2"
                                   FontWeight="Black"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,3,0,0">
                        <Border Background="{Binding OverallBadgeBackground}" MinWidth="20" Height="14" CornerRadius="7" Padding="4,0" Margin="0,0,3,0">
                            <TextBlock Text="{Binding OverallValueText}" Foreground="{Binding OverallBadgeForeground}" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding GrowthText}" Foreground="#22C55E" FontSize="7" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Border Background="{Binding WorkloadRiskBrush}"
                                Visibility="Collapsed"
                                CornerRadius="7"
                                Padding="3,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                ToolTip="{Binding WorkloadRiskTooltip}">
                            <TextBlock Text="{Binding WorkloadRiskText}"
                                       FontFamily="Segoe UI Emoji"
                                       Foreground="{Binding WorkloadRiskForeground}"
                                       FontSize="7"
                                       FontWeight="Black" />
                        </Border>
                        <Border Background="{Binding FatigueWarningBadgeBackground}"
                                Visibility="Collapsed"
                                CornerRadius="7"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                ToolTip="{Binding FatigueWarningTooltip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FatigueWarningText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FatigueWarningText}"
                                       Foreground="#FFFFFF"
                                       FontSize="7"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Background="{Binding BenchFormBadgeBackground}"
                                Visibility="Collapsed"
                                CornerRadius="7"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0">
                            <TextBlock Text="{Binding BenchFormBadgeText}"
                                       Foreground="{Binding BenchFormBadgeForeground}"
                                       FontSize="7"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Background="#EAF1FF"
                                CornerRadius="7"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                ToolTipService.ShowDuration="20000">
                            <Border.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{Binding TraitSummaryText}"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,7" />
                                        <ItemsControl ItemsSource="{Binding TraitBadges}"
                                                      ItemTemplate="{StaticResource TraitTooltipRowTemplate}" />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TraitCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding TraitIconText}"
                                           Foreground="#1E528F"
                                           FontSize="7.5"
                                           FontWeight="Black"
                                           Margin="0,0,2,0" />
                                <TextBlock Text="{Binding TraitCountText}"
                                           Foreground="#1E528F"
                                           FontSize="7"
                                           FontWeight="Black" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding CardStatusBadges}"
                                      ItemTemplate="{StaticResource CardStatusBadgeTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardStatusBadges.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,3,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="5" />
                        </Grid.RowDefinitions>
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding Stamina}"
                                     Foreground="{Binding StaminaBrush}"
                                     Background="#334155" BorderThickness="0" />
                        <ProgressBar Grid.Row="1" Margin="0,2,0,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding WorkloadRiskBarValue}"
                                     Foreground="{Binding WorkloadRiskBrush}"
                                     Background="#334155" BorderThickness="0"
                                     ToolTip="{Binding WorkloadRiskTooltip}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="MainRootGrid"
          Background="{DynamicResource AppPageBackground}"
          Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HalfTimePitchColumnDefinition" Width="2*" />
            <ColumnDefinition x:Name="HalfTimeSetupColumnDefinition" Width="320" />
        </Grid.ColumnDefinitions>

        <Button x:Name="CompactPitchToggleButton"
                Width="30" Height="30" Margin="4"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Panel.ZIndex="20" Visibility="Collapsed"
                Content="&#x2922;" ToolTip="Expand pitch"
                FontFamily="Segoe UI Symbol" FontSize="14" FontWeight="Black"
                Click="CompactPitchToggleButton_Click" />

        <Border x:Name="HalfTimePitchPanel" Grid.Column="0"
                Background="{DynamicResource MatchPitchBorderBrush}"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,18,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock x:Name="SetupTitleTextBlock"
                               Text="Half-Time Setup"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Black"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="ScoreTextBlock"
                               Foreground="{DynamicResource AppInverseTextBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource MatchPitchBackgroundBrush}"
                            BorderBrush="{DynamicResource MatchPitchLineBrush}"
                            BorderThickness="2"
                            CornerRadius="18">
                        <Grid>
                            <Line X1="0" Y1="0" X2="900" Y2="0" Stroke="{DynamicResource MatchPitchLineBrush}" Opacity="0.45" />
                            <Line X1="0" Y1="260" X2="900" Y2="260" Stroke="{DynamicResource MatchPitchLineBrush}" Opacity="0.35" />
                            <Ellipse Width="110"
                                     Height="110"
                                     Stroke="{DynamicResource MatchPitchLineBrush}"
                                     StrokeThickness="2"
                                     Opacity="0.45"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Canvas x:Name="PitchCanvas"
                                    Margin="16"
                                    SizeChanged="PitchCanvas_SizeChanged" />
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="14,0,0,14"
                                    Padding="7"
                                    CornerRadius="10"
                                    Background="{DynamicResource TacticalFloatingPanelBackground}"
                                    BorderBrush="{DynamicResource TacticalFloatingPanelBorder}"
                                    BorderThickness="1.2"
                                    IsHitTestVisible="False"
                                    MaxWidth="235">
                                <Border.Effect>
                                    <DropShadowEffect Color="#071226"
                                                      BlurRadius="12"
                                                      ShadowDepth="2"
                                                      Opacity="0.18" />
                                </Border.Effect>
                                <Grid>
                                    <TextBlock x:Name="SelectedPlayerEmptyTextBlock"
                                               Text="Select a player on the pitch."
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <Grid x:Name="SelectedPlayerCard"
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0">
                                                <controls:FlagBadge x:Name="SelectedPlayerFlagImage"
                                                                    Width="17"
                                                                    Height="12"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center" />
                                                <TextBlock x:Name="SelectedPlayerNameTextBlock"
                                                           Foreground="{DynamicResource AppTextBrush}"
                                                           FontSize="11.5"
                                                           FontWeight="Black"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border x:Name="SelectedPlayerOvrBadgeBorder"
                                                        CornerRadius="8"
                                                        Padding="5,2"
                                                        Margin="0,0,3,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="SelectedPlayerOvrBadgeTextBlock"
                                                               Foreground="White"
                                                               FontSize="8.5"
                                                               FontWeight="Black" />
                                                </Border>
                                                <Border x:Name="SelectedPlayerFormBadgeBorder"
                                                        CornerRadius="8"
                                                        Padding="5,2"
                                                        Background="{DynamicResource TacticalOptionBackground}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="SelectedPlayerFormBadgeTextBlock"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               FontSize="8.5"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <ItemsControl x:Name="SelectedPlayerTraitItemsControl"
                                                              ItemTemplate="{StaticResource TraitIconBadgeTemplate}"
                                                              Margin="4,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <ItemsControl x:Name="SelectedPlayerCardStatusItemsControl"
                                                              ItemTemplate="{StaticResource CardStatusBadgeTemplate}"
                                                              Margin="2,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="SelectedPlayerMetaTextBlock"
                                                   Grid.Row="1"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedPlayerLeftStat1Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SelectedPlayerLeftStat1Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Bold" />
                                                </Grid>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedPlayerLeftStat2Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SelectedPlayerLeftStat2Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Bold" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedPlayerLeftStat3Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SelectedPlayerLeftStat3Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Bold" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedPlayerRightStat1Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SelectedPlayerRightStat1Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Bold" />
                                                </Grid>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedPlayerRightStat2Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SelectedPlayerRightStat2Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Bold" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedPlayerRightStat3Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SelectedPlayerRightStat3Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Bold" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Visibility="Collapsed">
                                                <TextBlock x:Name="SelectedPlayerLeftStat4Label" />
                                                <TextBlock x:Name="SelectedPlayerLeftStat4Value" />
                                                <TextBlock x:Name="SelectedPlayerLeftStat5Label" />
                                                <TextBlock x:Name="SelectedPlayerLeftStat5Value" />
                                                <TextBlock x:Name="SelectedPlayerLeftStat6Label" />
                                                <TextBlock x:Name="SelectedPlayerLeftStat6Value" />
                                                <TextBlock x:Name="SelectedPlayerRightStat4Label" />
                                                <TextBlock x:Name="SelectedPlayerRightStat4Value" />
                                                <TextBlock x:Name="SelectedPlayerRightStat5Label" />
                                                <TextBlock x:Name="SelectedPlayerRightStat5Value" />
                                                <TextBlock x:Name="SelectedPlayerRightStat6Label" />
                                                <TextBlock x:Name="SelectedPlayerRightStat6Value" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,18,18"
                                    Padding="10,8"
                                    CornerRadius="13"
                                    Background="{DynamicResource TacticalFloatingPanelBackground}"
                                    BorderBrush="{DynamicResource TacticalFloatingPanelBorder}"
                                    BorderThickness="1.2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#071226"
                                                      BlurRadius="16"
                                                      ShadowDepth="2"
                                                      Opacity="0.26" />
                                </Border.Effect>
                                <StackPanel Width="168">
                                    <TextBlock Text="Formation ⚽"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               Margin="0,0,0,4" />
                                    <ComboBox x:Name="FormationComboBox"
                                              Height="28"
                                              FontSize="12"
                                              SelectionChanged="FormationComboBox_SelectionChanged">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="10"
                                                                   FontWeight="Black"
                                                                   Foreground="#2563EB"
                                                                   Margin="6,6,0,3" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource MatchPitchBorderBrush}"
                            BorderBrush="{DynamicResource MatchPitchLineBrush}"
                            BorderThickness="1.5"
                            CornerRadius="18"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Substitutes"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="SubstituteFilterTextBlock"
                                           Grid.Column="1"
                                           Text="All players"
                                           Foreground="#DDF7E8"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ClearSubstituteFilterButton"
                                        Grid.Column="2"
                                        Content="x"
                                        Width="22"
                                        Height="22"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        FontSize="11"
                                        FontWeight="Black"
                                        ToolTip="Show all substitutes"
                                        Visibility="Collapsed"
                                        Click="ClearSubstituteFilterButton_Click" />
                                <TextBlock x:Name="SubstitutionStatusTextBlock"
                                           Grid.Column="3"
                                           Foreground="#DDF7E8"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ListBox x:Name="SubstituteListBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     AllowDrop="True"
                                     PreviewDragEnter="SubstituteListBox_DragEnter"
                                     PreviewDragOver="SubstituteListBox_DragOver"
                                     PreviewDragLeave="SubstituteListBox_DragLeave"
                                     PreviewDrop="SubstituteListBox_Drop"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Opacity" Value="0.94" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <StaticResource ResourceKey="SubstituteCardTemplate" />
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="HalfTimeSetupPanel" Grid.Column="1"
                Background="{DynamicResource AppCardBackground}"
                CornerRadius="18"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Setup"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextBrush}"
                           Margin="0,0,0,8" />

                <Grid Grid.Row="1"
                      Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tactics"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TacticalInsightInfoIcon"
                               Grid.Column="1"
                               Text="i"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTipService.ShowDuration="30000" />
                </Grid>

                <controls:TacticalSettingsPanel x:Name="TacticalSettingsPanel"
                                                Grid.Row="2"
                                                PanelMaxHeight="620"
                                                TacticsChanged="TacticalSettingsPanel_TacticsChanged"
                                                FormationChanged="TacticalSettingsPanel_FormationChanged" />

                <Grid x:Name="CompactHalfTimeInsightsPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="All Players" Foreground="{DynamicResource AppTextBrush}"
                               FontSize="13" FontWeight="Black" Margin="0,0,0,6" />
                    <ListBox x:Name="CompactFirstHalfRatingsListBox" Grid.Row="1"
                             Height="260"
                             Background="{DynamicResource AppSecondaryCardBackground}"
                             BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="5"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="CompactFirstHalfRatingsListBox_MouseDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#E2E8F0" CornerRadius="6" Padding="7,3" Margin="0,4,0,5">
                                            <TextBlock Text="{Binding Name}" Foreground="#334155" FontSize="11" FontWeight="Black" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppCardBackground}" CornerRadius="8" Padding="8,7"
                                        ToolTip="{Binding RowToolTip}" AllowDrop="True"
                                        PreviewMouseLeftButtonDown="CompactPlayerRow_PreviewMouseLeftButtonDown"
                                        MouseMove="CompactPlayerRow_MouseMove"
                                        DragOver="CompactPlayerRow_DragOver"
                                        Drop="CompactPlayerRow_Drop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#E2E8F0" CornerRadius="6" Padding="4,1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Position}" Foreground="#334155" FontSize="10.5" FontWeight="Black" />
                                    </Border>
                                    <controls:FlagBadge Grid.Column="1" FlagSource="{Binding FlagImagePath}"
                                                        ToolTip="{Binding NationalityName}" Width="23" Height="16"
                                                        VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Grid Grid.Column="2" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBrush}"
                                                   FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding PendingSubstitutionVisibility}">
                                            <TextBlock Text="→" Foreground="#16A34A" FontSize="9" FontWeight="Black" Margin="0,0,3,0" />
                                            <controls:FlagBadge FlagSource="{Binding PendingSubstituteFlagImagePath}"
                                                                ToolTip="{Binding PendingSubstituteNationalityName}"
                                                                Width="16" Height="11" Margin="0,0,3,0" />
                                            <TextBlock Text="{Binding PendingSubstituteName}" Foreground="#15803D"
                                                       FontSize="9" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StaminaText}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="Bold" />
                                            <ProgressBar Grid.Column="1" Value="{Binding Stamina}" Maximum="100" Height="5"
                                                         Foreground="{Binding StaminaBrush}" Background="#D7DEE8" BorderThickness="0" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding InjuryRiskText}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" FontWeight="Bold" />
                                            <ProgressBar Grid.Column="1" Value="{Binding InjuryRisk}" Maximum="100" Height="5"
                                                         Foreground="{Binding InjuryRiskBrush}" Background="#D7DEE8" BorderThickness="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                    <Border Grid.Column="4" Background="{Binding RatingBackground}" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rating}" Foreground="{Binding RatingForeground}" FontSize="10.5" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Recommended substitutions" Foreground="{DynamicResource AppTextBrush}"
                               FontSize="13" FontWeight="Black" Margin="0,10,0,6" Visibility="Collapsed" />
                    <ItemsControl x:Name="CompactHalfTimeRecommendationsItemsControl" Grid.Row="3" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppSecondaryCardBackground}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" /><ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PlayerOutPosition}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="Black" />
                                                <controls:FlagBadge Grid.Column="1" FlagSource="{Binding PlayerOutFlag}"
                                                                    ToolTip="{Binding PlayerOutNationalityName}" Width="20" Height="14" />
                                                <TextBlock Grid.Column="2" Text="{Binding PlayerOutName}" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="3" Background="{Binding PlayerOutRatingBackground}" CornerRadius="7" Padding="4,1">
                                                    <TextBlock Text="{Binding PlayerOutRating}" Foreground="{Binding PlayerOutRatingForeground}" FontSize="8.5" FontWeight="Black" HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" /><ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PlayerInPosition}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="Black" />
                                                <controls:FlagBadge Grid.Column="1" FlagSource="{Binding PlayerInFlag}"
                                                                    ToolTip="{Binding PlayerInNationalityName}" Width="20" Height="14" />
                                                <TextBlock Grid.Column="2" Text="{Binding PlayerInName}" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="3" Background="{Binding PlayerInRatingBackground}" CornerRadius="7" Padding="4,1">
                                                    <TextBlock Text="{Binding PlayerInRating}" Foreground="{Binding PlayerInRatingForeground}" FontSize="8.5" FontWeight="Black" HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⇄" Width="30" Height="30" Margin="4,0,0,0"
                                                ToolTip="Make this substitution" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="Black"
                                                Foreground="White" Background="{DynamicResource AppAccentBrush}" BorderThickness="0"
                                                Click="CompactRecommendedSubstitutionButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Button x:Name="StartSecondHalfButton"
                        Grid.Row="4"
                        Content="Start Second Half"
                        Style="{StaticResource PrimaryTextButton}"
                        Height="40"
                        Margin="0,10,0,0"
                        FontWeight="SemiBold"
                        Click="StartSecondHalfButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
