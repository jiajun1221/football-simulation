                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4">
                            <TextBlock.Inlines>
                                <Run Text="Substitutes" />
                                <Run Text="   " />
                                <Run x:Name="SubsLeftTextBlock"
                                     Foreground="{DynamicResource AppMutedTextBrush}"
                                     FontSize="7"
                                     FontWeight="SemiBold" />
                            </TextBlock.Inlines>
                        </TextBlock>
                        <ListBox x:Name="PausedBenchListBox"
                                 Grid.Row="1"
                                 Tag="2"
                                 SelectionChanged="PausedBenchListBox_SelectionChanged"
                                 ItemTemplate="{StaticResource SubstitutionPlayerTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.LayoutTransform>
                                <ScaleTransform x:Name="StealthSubstitutesScaleTransform" ScaleX="1" ScaleY="1" />
                            </ListBox.LayoutTransform>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                 VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,8,7" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="4">
                                            <Setter Property="Margin" Value="0,0,2,3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="NoAvailableSubstituteTextBlock"
                                   Grid.Row="1"
                                   Text="No available substitute for this position"
                                   Foreground="{DynamicResource FeedAttackLabelForeground}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SubstitutionOverlay"
                  Grid.RowSpan="2"
                  Background="#A6112233"
                  Visibility="Collapsed">
                <Border Width="760"
                        Background="{DynamicResource AppSecondaryCardBackground}"
                        CornerRadius="14"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Make Substitution"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <TextBlock x:Name="SubstitutionOverlayStatusTextBlock"
                                   Grid.Row="1"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,18" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Current Starters"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />
                                <ListBox x:Name="LiveStarterListBox"
                                         Height="290"
                                         SelectionChanged="LiveStarterListBox_SelectionChanged"
                                         ItemTemplate="{StaticResource SubstitutionPlayerTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="Available Substitutes"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />
                                <ListBox x:Name="LiveBenchListBox"
                                         Height="290"
                                         SelectionChanged="LiveBenchListBox_SelectionChanged"
                                         ItemTemplate="{StaticResource SubstitutionPlayerTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Content="Cancel"
                                    Style="{StaticResource PrimaryTextButton}"
                                    Width="110"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Click="CancelSubstitutionButton_Click" />
                            <Button x:Name="ConfirmSubstitutionButton"
                                    Style="{StaticResource PrimaryTextButton}"
                                    Content="Confirm Substitution"
                                    Width="170"
                                    Height="36"
                                    IsEnabled="False"
                                    Click="ConfirmSubstitutionButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="TacticalAdjustmentOverlay"
                  Grid.RowSpan="2"
                  Background="#A6112233"
                  Visibility="Collapsed">
                <Border Width="560"
                        Background="{DynamicResource AppSecondaryCardBackground}"
                        CornerRadius="14"
                        Padding="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Tactical Adjustment"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="TacticalOverlayStatusTextBlock"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,4,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Formation"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="TacticalFormationComboBox"
                                      Grid.Column="1"
                                      MinHeight="28"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      TextSearch.TextPath="Name"
                                      SelectionChanged="FormationComboBox_SelectionChanged">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="6,4,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </Grid>

                        <controls:TacticalSettingsPanel x:Name="TacticalSettingsPanel"
                                                        IsCompact="True"
                                                        PanelMaxHeight="320"
                                                        FormationChanged="TacticalSettingsPanel_FormationChanged" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="Cancel"
                                    Style="{StaticResource PrimaryTextButton}"
                                    Width="92"
                                    Height="30"
                                    Margin="0,0,10,0"
                                    Click="CancelTacticalAdjustmentButton_Click" />
                            <Button Content="Apply Tactics"
                                    Style="{StaticResource PrimaryTextButton}"
                                    Width="120"
                                    Height="30"
                                    Click="ConfirmTacticalAdjustmentButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
