                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AttackPitchStatusBadge"
                                Width="32"
                                Height="28"
                                CornerRadius="14"
                                Background="#CCB42318"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                            <TextBlock x:Name="AttackPitchStatusIconTextBlock"
                                       Text="⚔"
                                       FontFamily="Segoe UI Symbol"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="DefensePitchStatusBadge"
                                Width="32"
                                Height="28"
                                CornerRadius="14"
                                Background="#CC174A8B"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <TextBlock x:Name="DefensePitchStatusIconTextBlock"
                                       Text="🛡"
                                       FontFamily="Segoe UI Symbol"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ItemsControl x:Name="PitchPlayersItemsControl"
                                  ItemsSource="{Binding}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  SizeChanged="LivePitchCanvas_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="PitchPlayerIconTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Margin="0,8,8,0"
                                Background="#66102033"
                                Opacity="0.82">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="32" />
                                <Setter Property="Height" Value="28" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Background" Value="#AA1A2D44" />
                                <Setter Property="Foreground" Value="{DynamicResource AppInverseTextBrush}" />
                                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="PauseResumeButton"
                                Content="&#x23F8;"
                                Click="PauseResumeButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="DecreaseSpeedButton"
                                Content="&#x23EA;"
