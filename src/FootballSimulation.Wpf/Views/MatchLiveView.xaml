                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />

                        <StackPanel x:Name="SelectedPlayerStatsPanel"
                                    Visibility="Collapsed">
                            <Grid Margin="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:FlagBadge FlagSource="{Binding FlagImagePath}"
                                                        ToolTip="{Binding NationalityName}"
                                                        Width="20"
                                                        Height="14"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center" />
                                    <TextBlock x:Name="SelectedPlayerNameTextBlock"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="SelectedPlayerBallStatusBorder"
                                            Grid.Column="2"
                                            Width="16"
                                            Height="16"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            Margin="4,0,0,0"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedPlayerBallStatusTextBlock"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ItemsControl x:Name="SelectedPlayerTraitItemsControl"
                                                  ItemTemplate="{StaticResource TraitIconBadgeTemplate}"
                                                  Margin="0,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ItemsControl x:Name="SelectedPlayerCardStatusItemsControl"
                                                  ItemTemplate="{StaticResource CardStatusBadgeTemplate}"
                                                  Margin="0,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        MinWidth="38"
                                        Height="25"
                                        Margin="6,0,0,0"
                                        Padding="5,0"
                                        CornerRadius="8"
                                        Background="{Binding RatingBadgeBackground}"
                                        BorderBrush="{Binding RatingBadgeBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding LiveStats.RatingDisplay}"
                                               Foreground="{Binding RatingBadgeForeground}"
                                               FontSize="11"
                                               FontWeight="Black"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="SelectedPlayerMetaTextBlock"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,4" />

                            <ItemsControl x:Name="SelectedPlayerMatchBadgesItemsControl"
                                          Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}"
                                                CornerRadius="6"
                                                Padding="4,1"
                                                Margin="0,0,3,2">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{Binding Foreground}"
                                                       FontFamily="Segoe UI Emoji"
                                                       FontSize="7.5"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stamina" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" />
                                <ProgressBar Grid.Column="1" Height="5" Margin="4,0" Minimum="0" Maximum="100"
                                             Value="{Binding Stamina, Mode=OneWay}" Foreground="{Binding StaminaBrush}"
                                             Background="{DynamicResource AppBorderBrush}" BorderThickness="0" />
                                <TextBlock Grid.Column="2" Text="{Binding Stamina, StringFormat={}{0:0}%}"
                                           Foreground="{DynamicResource AppTextBrush}" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Risk" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="8" />
                                <ProgressBar Grid.Column="1" Height="5" Margin="4,0" Minimum="0" Maximum="100"
                                             Value="{Binding WorkloadRiskPercentage, Mode=OneWay}" Foreground="{Binding WorkloadRiskBrush}"
                                             Background="{DynamicResource AppBorderBrush}" BorderThickness="0" />
                                <TextBlock Grid.Column="2" Text="{Binding WorkloadRiskPercentage, StringFormat={}{0}%}"
                                           Foreground="{Binding WorkloadRiskBrush}" FontSize="8" FontWeight="Bold" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SelectedPlayerAttackHeadingTextBlock" Text="ATTACK" Foreground="#C2410C" FontSize="8" FontWeight="Bold" Margin="0,0,0,3" />
                                <TextBlock x:Name="SelectedPlayerDefendHeadingTextBlock" Grid.Column="2" Text="DEFEND" Foreground="#1D4ED8" FontSize="8" FontWeight="Bold" Margin="0,0,0,3" />

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerLeftStat1Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerLeftStat1Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerLeftStat2Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerLeftStat2Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerLeftStat3Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerLeftStat3Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerLeftStat4Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerLeftStat4Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerLeftStat5Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerLeftStat5Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerLeftStat6Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerLeftStat6Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerRightStat1Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerRightStat1Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerRightStat2Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerRightStat2Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerRightStat3Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerRightStat3Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerRightStat4Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerRightStat4Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerRightStat5Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerRightStat5Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlayerRightStat6Label" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedPlayerRightStat6Value" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="10.5" FontWeight="Bold" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Tag="StealthHoverCard"
                        Background="{DynamicResource AppCardBackground}"
                        CornerRadius="12"
                        Padding="8"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid x:Name="PausedActionPanel"
                              Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Tactics"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <Button x:Name="ActionFormationButton"
                                            Grid.Column="1"
                                            Visibility="Collapsed"
                                            Content="Formation"
                                            Style="{StaticResource PrimaryTextButton}"
                                            Height="17"
                                            MinWidth="74"
                                            MaxWidth="96"
                                            Padding="3,0"
                                            FontSize="7.5"
                                            FontWeight="SemiBold"
                                            Click="ActionFormationButton_Click" />
                                </Grid>

                                <Popup x:Name="ActionFormationPopup"
                                       IsOpen="False"
                                       PlacementTarget="{Binding ElementName=ActionFormationButton}"
                                       Placement="Bottom"
                                       StaysOpen="True"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Width="156"
                                            Background="{DynamicResource AppCardBackground}"
                                            BorderBrush="{DynamicResource AppCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8"
                                            Margin="0,4,0,0">
                                        <ComboBox x:Name="ActionFormationComboBox"
                                                  MinHeight="26"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Name"
                                                  TextSearch.TextPath="Name"
                                                  SelectionChanged="FormationComboBox_SelectionChanged"
                                                  DropDownClosed="ActionFormationComboBox_DropDownClosed">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Margin="6,4,0,2" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                    </Border>
                                </Popup>

                                <controls:TacticalSettingsPanel x:Name="ActionTacticalSettingsPanel"
                                                                IsCompact="True"
                                                                ShowCompactTitle="False"
                                                                PanelMaxHeight="210"
                                                                FormationChanged="TacticalSettingsPanel_FormationChanged" />

                                <TextBlock x:Name="PausedActionStatusTextBlock"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           FontSize="8.5"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="PausedSubstitutionPanelBorder"
                        Tag="StealthHoverCard"
                        Grid.Column="2"
                        Background="{DynamicResource AppCardBackground}"
