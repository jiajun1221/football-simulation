                                Width="84"
                                Height="28"
                                Margin="2"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Click="ContinueButton_Click" />
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PlayerInfoColumnDefinition" Width="0.85*" />
                    <ColumnDefinition x:Name="InlineTacticsColumnDefinition" Width="1.15*" />
                    <ColumnDefinition x:Name="InlineSubstitutesColumnDefinition" Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SelectedPlayerDetailCardBorder"
                        Tag="StealthHoverCard"
                        Grid.Column="0"
                        Background="{DynamicResource AppCardBackground}"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,8,0">
                    <Grid>
                        <TextBlock x:Name="SelectedPlayerPlaceholderTextBlock"
                                   Text="Select a player on the pitch to view details."
