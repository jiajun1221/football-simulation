<UserControl x:Class="FootballSimulation.Wpf.Views.MatchLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FootballSimulation.Wpf.Models"
             xmlns:controls="clr-namespace:FootballSimulation.Wpf.Controls"
             Background="{DynamicResource AppPageBackground}">
    <UserControl.Resources>
        <DataTemplate x:Key="TraitIconBadgeTemplate">
            <Border Width="14"
                    Height="14"
                    Background="{Binding Background}"
                    CornerRadius="7"
                    Margin="1,0,0,0"
                    ToolTip="{Binding TooltipText}">
                <TextBlock Text="{Binding Icon}"
                           Foreground="{Binding Foreground}"
                           FontFamily="{Binding FontFamily}"
                           FontSize="8"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CardStatusBadgeTemplate">
            <Border MinWidth="14"
                    Height="14"
                    Background="{Binding Background}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="2,0,0,0"
                    ToolTip="{Binding TooltipText}">
                <TextBlock Text="{Binding Text}"
                           Foreground="{Binding Foreground}"
                           FontSize="7.5"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PitchPlayerIconTemplate" DataType="{x:Type models:LivePlayerIconViewModel}">
            <Grid Width="72"
                  Height="76"
                  Cursor="Hand"
                  AllowDrop="True"
                  PreviewMouseMove="PitchPlayerIcon_PreviewMouseMove"
                  MouseLeftButtonUp="PitchPlayerIcon_MouseLeftButtonUp"
                  Drop="PitchPlayerIcon_Drop"
                  ToolTipService.InitialShowDelay="180"
                  ToolTipService.ShowDuration="12000">
                <Grid.ToolTip>
                    <Border Width="205"
                                Padding="8"
                                CornerRadius="10"
                                Background="{DynamicResource AppCardBackground}"
                                BorderBrush="{Binding RatingBadgeBorderBrush}"
                                BorderThickness="2">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                            </Border.LayoutTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="{Binding IconBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="2"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding ExactPosition}"
                                                   Foreground="{Binding IconForeground}"
                                                   FontSize="8.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource AppMutedTextBrush}"
                                                   FontSize="8.5">
                                            <Run Text="{Binding TeamName}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            MinWidth="38"
                                            Height="28"
                                            Padding="5,0"
                                            CornerRadius="8"
                                            Background="{Binding RatingBadgeBackground}"
                                            BorderBrush="{Binding RatingBadgeBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding LiveStats.RatingDisplay}"
                                                   Foreground="{Binding RatingBadgeForeground}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Stamina"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               FontSize="8.5"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1"
                                                 Height="6"
                                                 Margin="6,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Stamina, Mode=OneWay}"
                                                 Foreground="{Binding StaminaBrush}"
                                                 Background="{DynamicResource AppBorderBrush}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Stamina, StringFormat={}{0:0}%}"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               FontSize="8.5"
                                               FontWeight="Bold" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,7,0,0" ToolTip="{Binding WorkloadRiskTooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Injury risk"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               FontSize="8.5"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1"
                                                 Height="6"
                                                 Margin="6,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding WorkloadRiskPercentage, Mode=OneWay}"
                                                 Foreground="{Binding WorkloadRiskBrush}"
                                                 Background="{DynamicResource AppBorderBrush}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding WorkloadRiskPercentage, StringFormat={}{0}%}"
                                               Foreground="{Binding WorkloadRiskBrush}"
                                               FontSize="8.5"
                                               FontWeight="Bold" />
                                </Grid>

                                <WrapPanel Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMatchStatBadges}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <Border Background="#DCFCE7" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding GoalBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding GoalBadgeText}" Foreground="#166534" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#FFEDD5" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding AssistBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding AssistBadgeText}" Foreground="#C2410C" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#DBEAFE" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding DefensiveBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding DefensiveBadgeText}" Foreground="#1D4ED8" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#CFFAFE" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SaveBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding SaveBadgeText}" Foreground="#0E7490" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding YellowBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding YellowBadgeText}" Foreground="#92400E" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#FEE2E2" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding RedBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding RedBadgeText}" Foreground="#B91C1C" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#FEE2E2" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding ErrorBadgeText}" Foreground="#B91C1C" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="6,3" Margin="2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding InjuryBadgeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding InjuryBadgeText}" Foreground="#92400E" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </WrapPanel>
                            </Grid>
                    </Border>
                </Grid.ToolTip>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{Binding RatingBadgeBackground}"
                        BorderBrush="{Binding RatingBadgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding LiveStats.RatingDisplay}"
                               Foreground="{Binding RatingBadgeForeground}"
                               FontSize="8"
                               FontWeight="Bold" />
                </Border>

                <Grid Grid.Row="1"
                      Width="42"
                      Height="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Background="#66E5E7EB"
                            CornerRadius="2" />
                    <Border Width="{Binding LiveStats.StaminaBarWidth, Mode=OneWay}"
                            Background="{Binding LiveStats.StaminaBrush, Mode=OneWay}"
                            CornerRadius="2"
                            HorizontalAlignment="Left" />
                </Grid>

                <Ellipse Grid.Row="2"
                         Width="40"
                         Height="40"
                         Stroke="{Binding SelectionBrush}"
                         StrokeThickness="{Binding SelectionThickness}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <Border Grid.Row="2"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="{Binding IconBrush}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Foreground="{Binding IconForeground}"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding ShirtNumberText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShirtNumberText}" Value="">
                                        <Setter Property="Text" Value="{Binding Initials}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Grid Grid.Row="2"
                      Width="18"
                      Height="18"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,8,0"
                      ToolTip="{Binding BallIndicatorTooltip}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBallIndicator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="{Binding BallIndicatorText}"
                               Foreground="{Binding BallIndicatorForeground}"
                               FontFamily="Segoe UI Emoji"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Effect="{Binding BallIndicatorEffect}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="2"
                        Background="#B42318"
                        CornerRadius="8"
                        Padding="5,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingSubOutBadgeText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PendingSubOutBadgeText}"
                               Foreground="White"
                               FontSize="9"
                               FontWeight="Black" />
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,1,0,0">
                    <Border Background="#7CFC9A" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GoalBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding GoalBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="#166534" />
                    </Border>
                    <Border Background="{DynamicResource FeedChanceIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AssistBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AssistBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedChanceIconForeground}" />
                    </Border>
                    <Border Background="{DynamicResource FeedDefensiveIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DefensiveBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DefensiveBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedDefensiveIconForeground}" />
                    </Border>
                    <Border Background="{DynamicResource FeedChanceIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedChanceIconForeground}" />
                    </Border>
                    <Border Background="{DynamicResource FeedDefensiveIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SaveBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedDefensiveIconForeground}" />
                    </Border>
                    <Border Background="{DynamicResource FeedFoulIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding YellowBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding YellowBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedFoulIconForeground}" />
                    </Border>
                    <Border Background="{DynamicResource FeedAttackIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RedBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RedBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedAttackIconForeground}" />
                    </Border>
                    <Border Background="{DynamicResource FeedAttackIconBackground}" CornerRadius="6" Padding="3,0" Margin="1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InjuryBadgeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding InjuryBadgeText}" FontFamily="Segoe UI Emoji" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource FeedAttackIconForeground}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SubstitutionPlayerTemplate">
            <StackPanel Margin="0,0,0,7">
                <Grid Margin="0,0,0,3">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingPlayerOutName}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource FeedAttackBackground}"
                            BorderBrush="{DynamicResource FeedAttackBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,2"
                            Margin="0,0,5,0">
                        <TextBlock Foreground="{DynamicResource FeedAttackLabelForeground}"
                                   FontSize="9"
                                   FontWeight="Black"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding PendingPlayerOutName}" />
                            <Run Text=" ↓" />
                        </TextBlock>
                    </Border>

                    <Button Grid.Column="1"
                            Width="22"
                            Height="22"
                            Content="X"
                            Foreground="{DynamicResource FeedAttackLabelForeground}"
                            Background="{DynamicResource FeedAttackBackground}"
                            BorderBrush="{DynamicResource FeedAttackBorder}"
                            BorderThickness="1"
                            FontSize="10"
                            FontWeight="Black"
                            Padding="0"
                            ToolTip="Cancel pending substitution"
                            PreviewMouseLeftButtonDown="CancelPendingSubstitutionButton_PreviewMouseLeftButtonDown"
                            Click="CancelPendingSubstitutionButton_Click" />
                </Grid>

                <Border Width="108"
                        Height="74"
                        Padding="6"
                        CornerRadius="8"
                        Background="{Binding CardBackground}"
                        BorderBrush="{Binding CardBorderBrush}"
                        BorderThickness="3"
                        PreviewMouseMove="BenchPlayerCard_PreviewMouseMove">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding PositionBackground}" CornerRadius="7" Padding="5,1" Margin="0,0,3,0">
                                    <TextBlock Text="{Binding Position}" Foreground="White" FontSize="7.5" FontWeight="Black" />
                                </Border>
                                <TextBlock Text="{Binding ShirtNumberText}" Foreground="White" FontSize="8" FontWeight="Black" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{Binding FormBadgeBackground}" CornerRadius="7" Padding="6,1">
                                <TextBlock Text="{Binding FormBadgeText}" Foreground="{Binding FormBadgeForeground}" FontSize="8" FontWeight="Black" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:FlagBadge FlagSource="{Binding FlagImagePath}" ToolTip="{Binding NationalityName}" Width="20" Height="14" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{Binding NameForeground}" FontSize="9.2" FontWeight="Black" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,1,0,0">
                            <Border Background="{Binding OverallBadgeBackground}" MinWidth="20" Height="14" CornerRadius="7" Padding="4,0" Margin="0,0,3,0">
                                <TextBlock Text="{Binding OverallValueText}" Foreground="{Binding OverallBadgeForeground}" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding GrowthText}" Foreground="#22C55E" FontSize="7" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <Border Background="{Binding FormBadgeBackground}"
                                    Visibility="Collapsed"
                                    CornerRadius="7"
                                    Padding="5,1"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,2,0">
                                <TextBlock Text="{Binding FormBadgeText}"
                                           Foreground="{Binding FormBadgeForeground}"
                                           FontSize="7"
                                           FontWeight="Bold" />
                            </Border>
                            <Border Background="{Binding WorkloadRiskBrush}"
                                    Visibility="Collapsed"
                                    CornerRadius="7"
                                    Padding="3,1"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,2,0"
                                    ToolTip="{Binding WorkloadRiskTooltip}">
                                <TextBlock Text="{Binding WorkloadRiskText}"
                                           FontFamily="Segoe UI Emoji"
                                           Foreground="{Binding WorkloadRiskForeground}"
                                           FontSize="7"
                                           FontWeight="Black" />
                            </Border>
                            <Border Background="{Binding FatigueWarningBadgeBackground}"
                                    Visibility="Collapsed"
                                    CornerRadius="7"
                                    Padding="5,1"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,2,0"
                                    ToolTip="{Binding FatigueWarningTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FatigueWarningText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FatigueWarningText}"
                                           Foreground="#FFFFFF"
                                           FontSize="7"
                                           FontWeight="Bold" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding TraitBadges}"
                                          ItemTemplate="{StaticResource TraitIconBadgeTemplate}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TraitBadges.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CardStatusBadges}"
                                          ItemTemplate="{StaticResource CardStatusBadgeTemplate}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardStatusBadges.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,3,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="5" />
                            </Grid.RowDefinitions>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding Stamina}"
                                         Foreground="{Binding StaminaBrush}"
                                         Background="#334155" BorderThickness="0" />
                            <ProgressBar Grid.Row="1" Margin="0,2,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding WorkloadRiskBarValue}"
                                         Foreground="{Binding WorkloadRiskBrush}"
                                         Background="#334155" BorderThickness="0"
                                         ToolTip="{Binding WorkloadRiskTooltip}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="LiveMatchRootGrid"
          Margin="20"
          Background="{DynamicResource AppPageBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LiveTrackerColumnDefinition" Width="320" />
            <ColumnDefinition x:Name="FullMatchColumnDefinition" Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LiveTrackerPanel"
              Grid.Column="0"
              Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ScoreboardPanel"
                    Background="#071226"
                    BorderBrush="#243247"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Button x:Name="CompactViewToggleButton"
                            Width="30"
                            Height="30"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="2"
                            Content="⤢"
                            ToolTip="Compact View"
                            FontFamily="Segoe UI Symbol"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#F8FAFC"
                            Background="#263B58"
                            BorderBrush="#4B6383"
                            BorderThickness="1"
                            Click="CompactViewToggleButton_Click" />
                    <StackPanel>
                    <TextBlock x:Name="PhaseTextBlock"
                               Foreground="#F8FAFC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />

                    <TextBlock x:Name="VenueTextBlock"
                               Foreground="#F8FAFC"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,4,0,0" />

                    <Grid x:Name="ScoreboardScoreGrid"
                          HorizontalAlignment="Stretch"
                          Margin="0,6,0,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScoreboardScaleTransform" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="HomeScorePanel"
                                Grid.Column="0"
                                Width="136"
                                Height="78"
                                Background="#172A45"
                                CornerRadius="9"
                                Padding="6"
                                HorizontalAlignment="Left">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HomeTeamNameTextBlock"
                                           Foreground="#DCE8F7"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HomeScoreTextBlock"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Black"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ScoreSeparatorTextBlock"
                                   Grid.Column="1"
                                   Text="-"
                                   Foreground="#F8FAFC"
                                   FontSize="22"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Margin="6,0" />

                        <Border x:Name="AwayScorePanel"
                                Grid.Column="2"
                                Width="136"
                                Height="78"
                                Background="#172A45"
                                CornerRadius="9"
                                Padding="6"
                                HorizontalAlignment="Right">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AwayTeamNameTextBlock"
                                           Foreground="#DCE8F7"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AwayScoreTextBlock"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Black"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="AggregateScorePanel"
                            HorizontalAlignment="Center"
                            Margin="0,7,0,0"
                            Padding="10,3"
                            Background="#16243A"
                            BorderBrush="#4B6383"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="AggregateScoreTextBlock"
                                   Foreground="#F8FAFC"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="CompactSetupPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource AppCardBackground}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CompactBallHolderCardBorder"
                            Grid.Row="0" Margin="0,0,0,6" Padding="7,5"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="CompactBallHolderCardBorder_MouseLeftButtonUp"
                            CornerRadius="9"
                            Background="Transparent"
                            BorderBrush="#94A3B8"
                            BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=CompactContinueButton}" Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CompactBallHolderActionBadge"
                                Width="28" Height="28" CornerRadius="14"
                                Background="#EEF2F7" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock x:Name="CompactBallHolderActionIconTextBlock"
                                       Text="•" Foreground="#667085" FontFamily="Segoe UI Emoji"
                                       FontSize="13" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="CompactBallHolderPositionBadge"
                                Grid.Column="2"
                                Width="28" Height="28" CornerRadius="14"
                                Background="#64748B" BorderBrush="#94A3B8" BorderThickness="2">
                            <TextBlock x:Name="CompactBallHolderPositionTextBlock"
                                       Text="--" Foreground="White" FontSize="10" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:FlagBadge x:Name="CompactBallHolderFlagBadge"
                                                Width="22" Height="15" Margin="0,0,5,0"
                                                VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="CompactBallHolderNameTextBlock" Grid.Column="1"
                                       Text="Waiting for possession" Foreground="{DynamicResource AppTextBrush}"
                                       FontSize="16" FontWeight="Black" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="CompactBallHolderRatingBadge"
                                Grid.Column="3" MinWidth="38" Height="28" CornerRadius="9"
                                Background="#FACC15" BorderBrush="#CA8A04" BorderThickness="1">
                            <TextBlock x:Name="CompactBallHolderRatingTextBlock"
                                       Text="--" Foreground="#1F2937" FontSize="11" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    </Border>

                    <Border x:Name="CompactBallHolderDetailsBorder" Grid.Row="1"
                            Visibility="Collapsed" Margin="0,0,0,6" Padding="9,7"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stamina" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" />
                                <ProgressBar x:Name="CompactBallHolderStaminaBar" Grid.Column="1" Height="6"
                                             Minimum="0" Maximum="100" Background="#D7DEE8" BorderThickness="0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompactBallHolderStaminaTextBlock" Grid.Column="2" Text="--"
                                           Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Black" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Injury risk" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" />
                                <ProgressBar x:Name="CompactBallHolderInjuryRiskBar" Grid.Column="1" Height="6"
                                             Minimum="0" Maximum="100" Background="#D7DEE8" BorderThickness="0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompactBallHolderInjuryRiskTextBlock" Grid.Column="2" Text="--"
                                           Foreground="{DynamicResource AppTextBrush}" FontSize="9" FontWeight="Black" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl x:Name="CompactBallHolderStatsBadgesItemsControl" Grid.Row="2"
                                          HorizontalAlignment="Center" Margin="0,7,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}" CornerRadius="8" Padding="7,2" Margin="2,0">
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                       FontFamily="Segoe UI Emoji" FontSize="9" FontWeight="Black" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Button x:Name="CompactContinueButton" Grid.Row="0"
                            Height="42" Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            FontSize="13" FontWeight="Black"
                            Visibility="Collapsed" IsEnabled="False"
                            Click="ContinueButton_Click">
                        <TextBlock x:Name="CompactContinueButtonTextBlock"
                                   Text="Continue" Foreground="#FFFFFF"
                                   FontSize="13" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Background" Value="#071226" />
                                <Setter Property="BorderBrush" Value="#071226" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#15345F" />
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel x:Name="CompactScoreControlsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CompactPauseResumeButton" Content="&#x2161;" Width="54" Height="28" Margin="2"
                                ToolTip="Pause match" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Black" Foreground="#991B1B"
                                Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1"
                                Click="PauseResumeButton_Click" />
                        <Button x:Name="CompactDecreaseSpeedButton" Content="&#x25C0;&#x25C0;" Width="38" Height="28" Margin="2"
                                ToolTip="Slower" FontFamily="Segoe UI Symbol" FontSize="10" FontWeight="Black" Foreground="#1E3A5F"
                                Background="#DBEAFE" BorderBrush="#60A5FA" BorderThickness="1"
                                Click="DecreaseSpeedButton_Click" />
                        <Border Width="46" Height="28" CornerRadius="9" Background="#DCEBFF" Margin="2">
                            <TextBlock x:Name="CompactSpeedLevelTextBlock" Text="1x" Foreground="#071226" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="CompactIncreaseSpeedButton" Content="&#x25B6;&#x25B6;" Width="38" Height="28" Margin="2"
                                ToolTip="Faster" FontFamily="Segoe UI Symbol" FontSize="10" FontWeight="Black" Foreground="#1E3A5F"
                                Background="#DBEAFE" BorderBrush="#60A5FA" BorderThickness="1"
                                Click="IncreaseSpeedButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="CompactPausedControlsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="CompactResumeButton" Content="&#x25B6;" Width="48" Height="28" Margin="2" ToolTip="Resume match"
                                FontFamily="Segoe UI Symbol" FontSize="14" FontWeight="Black" Foreground="#166534" Background="#DCFCE7"
                                BorderBrush="#4ADE80" BorderThickness="1" Click="PauseResumeButton_Click" />
                        <Button x:Name="CompactTacticsButton" Content="Tactics" Width="64" Height="28" Margin="2"
                                FontSize="10" FontWeight="Black" Foreground="#1D4ED8" Background="#DBEAFE"
                                BorderBrush="#60A5FA" BorderThickness="1" Click="CompactTacticsButton_Click" />
                        <Button x:Name="CompactSubsButton" Content="Subs" Width="54" Height="28" Margin="2"
                                FontSize="10" FontWeight="Black" Foreground="#6D28D9" Background="#EDE9FE"
                                BorderBrush="#C4B5FD" BorderThickness="1" Click="CompactSubsButton_Click" />
                    </StackPanel>

                    <Popup x:Name="CompactTacticsPopup" PlacementTarget="{Binding ElementName=CompactTacticsButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Width="350" Margin="0,5,0,0" Padding="9" CornerRadius="9"
                                Background="{DynamicResource AppCardBackground}" BorderBrush="#60A5FA" BorderThickness="2">
                            <controls:TacticalSettingsPanel x:Name="CompactTacticalSettingsPanel"
                                                            IsCompact="True" ShowCompactTitle="False" PanelMaxHeight="250"
                                                            TacticsChanged="CompactTacticalSettingsPanel_TacticsChanged"
                                                            FormationChanged="TacticalSettingsPanel_FormationChanged" />
                        </Border>
                    </Popup>

                    <Popup x:Name="CompactSubsPopup" PlacementTarget="{Binding ElementName=CompactSubsButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Width="350" Margin="0,5,0,0" Padding="9" CornerRadius="9"
                                Background="{DynamicResource AppCardBackground}" BorderBrush="#C4B5FD" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="Recommended Substitutions" Foreground="{DynamicResource AppTextBrush}"
                                           FontSize="12" FontWeight="Black" Margin="0,0,0,5" />
                                <ItemsControl x:Name="CompactSubstitutionRecommendationsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" /><ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="3,1" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding PlayerOutPosition}" Foreground="#991B1B" FontSize="8.5" FontWeight="Black" />
                                                    </Border>
                                                    <controls:FlagBadge Grid.Column="1" FlagSource="{Binding PlayerOutFlagImagePath}"
                                                                        ToolTip="{Binding PlayerOutNationalityName}" Width="20" Height="14" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PlayerOutName}" Foreground="{DynamicResource AppTextBrush}"
                                                               FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="3" Background="{Binding PlayerOutRatingBackground}" CornerRadius="7" Padding="4,1">
                                                        <TextBlock Text="{Binding PlayerOutRating}" Foreground="{Binding PlayerOutRatingForeground}"
                                                                   FontSize="8.5" FontWeight="Black" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" /><ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="3,1" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding PlayerInPosition}" Foreground="#166534" FontSize="8.5" FontWeight="Black" />
                                                    </Border>
                                                    <controls:FlagBadge Grid.Column="1" FlagSource="{Binding PlayerInFlagImagePath}"
                                                                        ToolTip="{Binding PlayerInNationalityName}" Width="20" Height="14" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PlayerInName}" Foreground="{DynamicResource AppTextBrush}"
                                                               FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="3" Background="{Binding PlayerInRatingBackground}" CornerRadius="7" Padding="4,1">
                                                        <TextBlock Text="{Binding PlayerInRating}" Foreground="{Binding PlayerInRatingForeground}"
                                                                   FontSize="8.5" FontWeight="Black" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Reason}" Foreground="{Binding ReasonBrush}" FontSize="8.5"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Width="32" Height="32" Margin="6,0,0,0"
                                                    ToolTip="Make this substitution"
                                                    Background="{DynamicResource AppAccentBrush}" Foreground="White"
                                                    BorderThickness="0" Visibility="{Binding ActionButtonVisibility}"
                                                    Click="CompactRecommendedSubstitutionButton_Click">
                                                <Grid Width="18" Height="18">
                                                    <Path Data="M 1,5 L 13,5 M 10,2 L 13,5 L 10,8"
                                                          Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M 17,13 L 5,13 M 8,10 L 5,13 L 8,16"
                                                          Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Grid>
                                            </Button>
                                            <Border Grid.Column="1" Visibility="{Binding PendingVisibility}"
                                                    Background="#DCFCE7" BorderBrush="#4ADE80" BorderThickness="1"
                                                    CornerRadius="8" Padding="6,3" Margin="5,0,0,0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Pending" Foreground="#166534" FontSize="8.5" FontWeight="Black" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoCompactSubstitutionRecommendationsTextBlock"
                                   Text="No urgent substitutions recommended."
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="9"
                                   Margin="4,5"
                                   Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Border x:Name="FeedPanel"
                    Grid.Row="2"
                    Background="{DynamicResource AppCardBackground}"
                    CornerRadius="12"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Live Match Feed"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <Grid x:Name="CompactFeedControlsTarget"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />

                        <Border x:Name="LiveStatusBadge"
                                Grid.Column="1"
                                Background="{DynamicResource AppPanelBackground}"
                                CornerRadius="12"
                                Padding="8,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LiveStatusIconTextBlock"
                                           Text="•"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveStatusTextBlock"
                                           Text="Neutral..."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                    </Grid>

                    <ListBox x:Name="MatchEventsListBox"
                             Grid.Row="1"
                             Background="{DynamicResource AppPanelBackground}"
                             BorderThickness="0"
                             Padding="6"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MatchFeedItem}">
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="9"
                                        Background="{Binding RowBackground}"
                                        BorderBrush="{Binding RowBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="15"
                                                Background="{Binding IconBackground}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe UI Emoji"
                                                       FontSize="17"
                                                       Foreground="{Binding IconForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MinuteText}"
                                                           Foreground="{Binding MinuteForeground}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="0,0,8,0" />
                                                <Border Background="{Binding LabelBackground}"
                                                        CornerRadius="7"
                                                        Padding="5,1">
                                                    <TextBlock Text="{Binding EventLabel}"
                                                               Foreground="{Binding LabelForeground}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{Binding TitleForeground}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />

                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{Binding DescriptionForeground}"
                                                       FontSize="11"
                                                       LineHeight="16"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                Background="{Binding TraitBadgeBackground}"
                                                BorderBrush="{Binding TraitBadgeBorderBrush}"
                                                BorderThickness="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Top"
                                                ToolTip="{Binding TriggeredTraitDescription}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTriggeredTrait}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TriggeredTraitIcon}"
                                                       FontFamily="Segoe UI Emoji"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="FullMatchLayoutGrid"
              Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FullMatchPitchRowDefinition" Height="6.3*" />
                <RowDefinition x:Name="FullMatchControlsRowDefinition" Height="3.7*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource MatchPitchBorderBrush}"
                    CornerRadius="14"
                    Padding="10">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource MatchPitchBackgroundBrush}"
                               RadiusX="12"
                               RadiusY="12" />
                    <Line X1="0" Y1="0" X2="0" Y2="900"
                          Stroke="{DynamicResource MatchPitchLineBrush}"
                          StrokeThickness="2"
                          Opacity="0.65"
                          HorizontalAlignment="Center" />
                    <Ellipse Width="150"
                             Height="150"
                             Stroke="{DynamicResource MatchPitchLineBrush}"
                             StrokeThickness="2"
                             Opacity="0.55"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    <Rectangle Width="120"
                               Height="260"
                               Stroke="{DynamicResource MatchPitchLineBrush}"
                               StrokeThickness="2"
                               Opacity="0.45"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0" />
                    <Rectangle Width="120"
                               Height="260"
                               Stroke="{DynamicResource MatchPitchLineBrush}"
                               StrokeThickness="2"
                               Opacity="0.45"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0" />

                    <Grid IsHitTestVisible="False"
