<Window x:Class="FootballSimulation.Wpf.Views.TransferTermsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Terms" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock" FontSize="23" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock x:Name="PlayerTextBlock" Margin="0,4,0,18" FontSize="14" Foreground="#64748B" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <StackPanel x:Name="PermanentFieldsPanel">
                <StackPanel x:Name="TransferFeeFieldPanel">
                <TextBlock Text="Transfer fee (€ millions)" FontWeight="SemiBold" />
                <TextBox x:Name="FeeTextBox" Height="34" Margin="0,5,0,4" Padding="8" />
                <TextBlock x:Name="ExpectedFeeTextBlock" Foreground="#64748B" FontSize="11" Margin="2,0,0,10" />
                </StackPanel>
                <TextBlock Text="Weekly wage (€ thousands)" FontWeight="SemiBold" />
                <TextBox x:Name="WageTextBox" Height="34" Margin="0,5,0,4" Padding="8" />
                <TextBlock x:Name="ExpectedWageTextBlock" Foreground="#64748B" FontSize="11" Margin="2,0,0,10" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Contract length" FontWeight="SemiBold" />
                        <ComboBox x:Name="YearsComboBox" Height="34" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Squad role" FontWeight="SemiBold" />
                        <ComboBox x:Name="RoleComboBox" Height="34" Margin="0,5,0,0" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
            <StackPanel x:Name="LoanFieldsPanel">
                <TextBlock Text="Loan fee (€ millions)" FontWeight="SemiBold" />
                <TextBox x:Name="LoanFeeTextBox" Height="34" Margin="0,5,0,4" Padding="8" Text="0" />
                <TextBlock Text="Expected: €0–€1M for a standard development loan." Foreground="#64748B" FontSize="11" Margin="2,0,0,10" />
                <TextBlock Text="Borrowing club wage contribution" FontWeight="SemiBold" />
                <ComboBox x:Name="WageShareComboBox" Height="34" Margin="0,5,0,0" />
                <TextBlock Text="Expected: 50% for a standard development loan." Foreground="#64748B" FontSize="11" Margin="2,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="ValidationTextBlock" Foreground="#DC2626" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Width="100" Height="36" Margin="0,0,10,0" Background="#334155" Click="CancelButton_Click">
                <TextBlock Text="Cancel" Foreground="#FFFFFF" FontWeight="Bold" />
            </Button>
            <Button x:Name="SubmitButton" Width="150" Height="36" Background="#061226" Click="SubmitButton_Click">
                <TextBlock x:Name="SubmitButtonTextBlock" Foreground="#FFFFFF" FontWeight="Bold" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
